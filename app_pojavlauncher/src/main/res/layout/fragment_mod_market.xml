<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- Список модов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/market_mod_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="148dp"
        android:paddingBottom="60dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

    <!-- Статус / ошибка -->
    <TextView
        android:id="@+id/market_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="14sp"
        android:textColor="#A0A0A0"
        android:visibility="gone" />

    <!-- Шапка -->
    <LinearLayout
        android:id="@+id/market_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Поле поиска -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#1E1E1E"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/market_search_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search mods..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@null"
                android:paddingHorizontal="14dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/market_search_button"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:text="Go"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#388E3C"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Фильтры -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Источник -->
            <TextView
                android:id="@+id/market_source_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Modrinth"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#1E1E1E"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Сортировка -->
            <TextView
                android:id="@+id/market_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="↓ Downloads"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#1E1E1E"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Фильтр версии -->
            <TextView
                android:id="@+id/market_filter_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#1E1E1E"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Прогресс бар тонкий -->
    <ProgressBar
        android:id="@+id/market_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="144dp"
        android:progressTint="#388E3C"
        android:visibility="gone" />

    <!-- Пагинация внизу -->
    <LinearLayout
        android:id="@+id/market_pagination"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#111111"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/market_prev_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="‹"
            android:textColor="#A0A0A0"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/market_page_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#A0A0A0"
            android:text="1 / 1"
            android:layout_marginHorizontal="12dp" />

        <TextView
            android:id="@+id/market_next_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="›"
            android:textColor="#A0A0A0"
            android:textSize="20sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
