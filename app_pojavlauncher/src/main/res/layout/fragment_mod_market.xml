<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Список модов — за шапкой -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/market_mod_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="130dp"
        android:paddingBottom="56dp"
        android:clipToPadding="false" />

    <!-- Статус / ошибка -->
    <TextView
        android:id="@+id/market_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Шапка — прячется при скролле -->
    <LinearLayout
        android:id="@+id/market_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_app"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/market_search_edit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Поиск модов..."
                android:background="@drawable/background_line"
                android:paddingHorizontal="12dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/market_search_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Найти"
                android:paddingHorizontal="16dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/market_source_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Modrinth"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/market_filter_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/market_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="↓ Популярные"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Прогресс бар -->
    <ProgressBar
        android:id="@+id/market_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="126dp"
        android:visibility="gone" />

    <!-- Пагинация внизу -->
    <LinearLayout
        android:id="@+id/market_pagination"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/background_app"
        android:elevation="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/market_prev_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="◀"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/market_page_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="1 / 1"
            android:layout_marginHorizontal="8dp" />

        <Button
            android:id="@+id/market_next_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="▶"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</FrameLayout>
