<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/background_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Иконка 80x80 -->
    <ImageView
        android:id="@+id/market_mod_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="14dp"
        android:scaleType="centerCrop"
        android:background="@drawable/background_icon_edit"
        android:clipToOutline="true"
        android:src="@drawable/ic_curseforge" />

    <!-- Контент -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Название -->
        <TextView
            android:id="@+id/market_mod_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <!-- Теги -->
        <LinearLayout
            android:id="@+id/market_mod_tags_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Описание -->
        <TextView
            android:id="@+id/market_mod_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:alpha="0.75"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Статистика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_add"
                android:layout_marginEnd="3dp"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/market_mod_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.5"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_updated"
                android:layout_marginEnd="3dp"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/market_mod_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.5" />

        </LinearLayout>

        <!-- Строка автора + совместимость -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/market_mod_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:alpha="0.45"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/market_mod_loaders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:alpha="0.4"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Расширенная панель -->
        <LinearLayout
            android:id="@+id/market_mod_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/background_line"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/market_mod_version_selectors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/market_mod_version_picker"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="All Game Versions ▾"
                    android:textSize="12sp"
                    android:background="@drawable/background_line"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/market_mod_loader_picker"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="All Mod Loaders ▾"
                    android:textSize="12sp"
                    android:background="@drawable/background_line"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Прогресс скачивания -->
            <TextView
                android:id="@+id/market_mod_download_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.6"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/market_mod_download_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/market_mod_download_btn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="↓ Скачать"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/background_line" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
