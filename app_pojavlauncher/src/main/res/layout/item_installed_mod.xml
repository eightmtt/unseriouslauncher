<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/background_line"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:gravity="center_vertical"
    android:minHeight="72dp">

    <!-- Иконка из jar или лого Mojo -->
    <ImageView
        android:id="@+id/mod_item_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_mojo_full" />

    <TextView
        android:id="@+id/mod_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Кнопка CurseForge -->
    <ImageButton
        android:id="@+id/mod_item_curseforge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_curseforge"
        android:contentDescription="CurseForge"
        android:padding="4dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/mod_item_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp" />

    <ImageButton
        android:id="@+id/mod_item_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_delete_forever"
        android:contentDescription="Удалить"
        android:padding="4dp" />

</LinearLayout>
